LLM_API_KEY=

# This service's own database (debt_reviews / debt_issues), read/write.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/technical_debt_db

# analysis-engine's database, read-only. Matches analysis-engine's own
# docker-compose.yml (host port 5434, postgres/postgres, analysis_engine_db).
ANALYSIS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/analysis_engine_db

# Optional overrides (defaults in src/config.py)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5.6-luna
# LLM_CONCURRENCY=5
# DEVELOPER_HOURLY_RATE=25
# MAX_FINDINGS_PER_RUN=200
# FRONTEND_ORIGIN=http://localhost:3000
# PORT=5003
