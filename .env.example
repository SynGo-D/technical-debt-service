LLM_API_KEY=

# This service's own database (debt_reviews / debt_issues), read/write.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/technical_debt_db

# analysis-engine's database, read-only.
#
# Check which one analysis-engine is actually using before trusting this
# default. Its docker-compose.yml publishes 5434, but a local checkout run
# outside Docker reads DB_PORT from its own .env and is commonly on 5432 —
# pointing here at the wrong one gives a service that starts, reports
# ready, and then fails every calculation on a missing column, because the
# readiness check is only SELECT 1.
ANALYSIS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/analysis_engine_db

# The shared platform broker — the SAME one analysis-engine publishes to.
# With this set, a finished analysis calculates debt on its own; leave it
# empty to calculate only on request.
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Optional overrides (defaults in src/config.py)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5.6-luna
# LLM_CONCURRENCY=5
# DEVELOPER_HOURLY_RATE=25
# MAX_FINDINGS_PER_RUN=200
# Whether an analysis.completed event triggers calculation by itself. This
# is the cost switch: two LLM calls per finding, spent without anyone
# asking. Off still consumes and acknowledges the events.
# AUTO_CALCULATE=true
# Findings above which an event is skipped rather than costed. 0 disables.
# AUTO_CALCULATE_MAX_FINDINGS=400
# FRONTEND_ORIGIN=http://localhost:3000
# PORT=5003
